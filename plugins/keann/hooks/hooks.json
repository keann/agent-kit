{
    "description": "Adds the working rules to every session and asks before git commit or push",
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/working-rules.md\""
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/confirm-git-write.sh\""
                    }
                ]
            }
        ]
    }
}
